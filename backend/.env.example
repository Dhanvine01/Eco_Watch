NODE_ENV=development
SIMULATION_ENABLED=true
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecowatch
JWT_SECRET=change-me-in-local-env
NOTIFICATION_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
ALERT_WHATSAPP_TO=

# ─── AI Provider ───────────────────────────────────────────────────────────────
# Options: qwen | openai | mock | auto
# auto → tries qwen first, then openai, then always-available mock.
AI_PROVIDER=auto

# Total timeout per AI analysis request in ms
AI_TIMEOUT_MS=30000

# Maximum retry attempts on transient failures (0 = no retry)
AI_MAX_RETRIES=2

# Fall back to mock provider if primary fails (true/false)
AI_FALLBACK_TO_MOCK=true

# ─── Qwen3-VL (vision) ────────────────────────────────────────────────────────
# Get key from: https://dashscope.aliyuncs.com
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL_NAME=qwen-vl-max-latest
QWEN_TIMEOUT_MS=30000
QWEN_MAX_TOKENS=2048

# ─── OpenAI GPT-4o (alternative vision provider) ──────────────────────────────
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_TOKENS=2048

# ─── Mock provider (development / testing) ────────────────────────────────────
# Simulated network latency in ms (set to 0 in tests)
MOCK_AI_LATENCY_MS=800
# Set to "true" to force mock to always return an error (for testing error paths)
MOCK_AI_FORCE_ERROR=false

# ─── Sensor ML (Python) ───────────────────────────────────────────────────────
# Set to "true" to start the Python ML prediction service at startup.
# Requires Python 3.8+ and: pip install -r ml/requirements.txt
# EcoGen starts normally if this is false or Python is unavailable.
ML_ENABLED=false
ML_PREDICTION_TIMEOUT_MS=10000
